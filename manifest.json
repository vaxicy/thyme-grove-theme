      "ntp_background":               [236, 232, 200],
      "ntp_text":                     [47, 58, 40],
      "ntp_link":                     [74, 87, 65],
      "ntp_header":                   [178, 189, 126],
      "button_background":            [178, 189, 126],
      "button_background_secondary":  [198, 208, 149],
      "omnibox_background":           [245, 242, 220],
      "omnibox_text":                 [47, 58, 40],
      "toolbar_button_icon":          [47, 58, 40]
