  "description": "An earthy olive-green Chrome theme in four herbal tones — soft sage chrome over a pale thyme grove.",
  "icons": {
    "128": "logo/logo.png"
  },
  "theme": {
    "colors": {
      "frame":                        [178, 189, 126],
